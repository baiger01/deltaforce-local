# Keep only reviewed source and static protocol metadata in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/DATA_PROVENANCE.md
!/docs/
!/.github/
!/outputs/
!/work/

/outputs/*
!/outputs/df-local-server/
!/outputs/native-account-provider/
!/outputs/sdk-call-observer/

/outputs/df-local-server/*
!/outputs/df-local-server/dfserver/
!/outputs/df-local-server/tests/
!/outputs/df-local-server/tools/
!/outputs/df-local-server/protocol/
!/outputs/df-local-server/README.md
!/outputs/df-local-server/definitions.json
!/outputs/df-local-server/demo.py
!/outputs/df-local-server/requirements-optional.txt
!/outputs/df-local-server/*.cmd

/outputs/df-local-server/protocol/*
!/outputs/df-local-server/protocol/*_catalog.json
!/outputs/df-local-server/protocol/medicine_sale_policy.json
!/outputs/df-local-server/protocol/business_contracts.json
!/outputs/df-local-server/protocol/generated_class_metadata.json
!/outputs/df-local-server/protocol/generated_codec_fields.json
!/outputs/df-local-server/protocol/lobby_bootstrap_requirements.json
!/outputs/df-local-server/protocol/local_map_board_candidates.json
!/outputs/df-local-server/protocol/safehouse_max_level_candidates.json
!/outputs/df-local-server/protocol/lua_cache_inventory.json
!/outputs/df-local-server/protocol/candidate_business.pb
!/outputs/df-local-server/protocol/recovered_telemetry.pb

/outputs/native-account-provider/*
!/outputs/native-account-provider/provider.c
!/outputs/native-account-provider/*.py
!/outputs/native-account-provider/*-abi.json
/outputs/sdk-call-observer/*
!/outputs/sdk-call-observer/identity-abi.json

/work/*
!/work/*.py

# Never upload local accounts, sessions, captures, game assets or build products.
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/data/
**/evidence/
**/native-test-account/
**/native-client-tests/
**/native-provider-tests/
**/elevated-native-trials/
**/sdk-local-provider-stage/
*.py[cod]
*.sqlite*
*.db
*.db-*
*.log
*.jsonl
*.dll
*.exe
*.bin
*.dfcode
*.pak
*.uasset
*.uexp
*.ubulk
*.etl
*.pcap
*.pcapng
*.zip
*.7z
*.png
*.jpg
*.jpeg
*.env
